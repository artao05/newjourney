{
  "name": "newjourney",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Open, phone-first weather routing and tactical navigation for sailors",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-budget.ts",
    "test:phone": "node scripts/phone-layout.ts",
    "test:phone:webkit": "node scripts/phone-layout.ts --webkit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "maplibre-gl": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.64.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
